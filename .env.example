# 大模型（DeepSeek，户型识别与匹配智能体）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# 数据存储
# 网站默认使用内置 PGlite（进程内嵌入式存储，数据落在 .pglite-data/），无需外部数据库。
# 只有换成托管数据库时才需要设置：
# DATABASE_URL=
# 后台任务运行时 apps/worker 才需要队列服务，网站本身不需要：
REDIS_URL=

# 阿里云 OSS
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 登录（apps/web/.env.local）：会话签名密钥（至少 32 个字符）与老板账号
SESSION_SECRET=
BOSS_PHONE=
BOSS_PASSWORD=

# Agnes 图像生成
AGNES_API_KEY=
